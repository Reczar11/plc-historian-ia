/* PLC Historian - dark industrial theme (AVEVA-style). Tokens: see theme/__init__.py */

QWidget {
    background-color: @bg;
    color: @text;
    font-size: 13px;
}
QLabel { background: transparent; }
QLabel#statusLabel { color: @accent; padding: 4px 8px; font-weight: bold; }
QLabel#trendTitle { font-size: 15px; font-weight: bold; padding: 8px; color: @text; }

QToolTip { background-color: @panel_alt; color: @text; border: 1px solid @accent; padding: 4px; }

/* ---- Toolbars / menus ---- */
QToolBar {
    background-color: @panel_alt;
    border: none;
    border-bottom: 1px solid @border;
    padding: 3px;
    spacing: 6px;
}
QToolBar QWidget { background-color: transparent; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 3px; padding: 4px; }
QToolButton:hover { background-color: @hover; border-color: @border; }
QToolButton:checked { background-color: @select; border-color: @accent; }

QMenuBar { background-color: @panel_alt; color: @text; }
QMenuBar::item:selected { background-color: @select; }
QMenu { background-color: @panel; color: @text; border: 1px solid @border; }
QMenu::item { padding: 5px 24px; }
QMenu::item:selected { background-color: @select; }
QMenu::separator { height: 1px; background: @border; margin: 4px 0; }

/* ---- Dock panels ---- */
QDockWidget { color: @text; }
QDockWidget::title {
    background-color: @panel_alt;
    padding: 6px 8px;
    border-bottom: 2px solid @accent;
}
QMainWindow::separator { background: @border; width: 2px; height: 2px; }
QMainWindow::separator:hover { background: @accent; }

/* ---- Trees / tables ---- */
QTreeView, QTreeWidget, QTableView, QTableWidget, QListView, QListWidget {
    background-color: @panel;
    alternate-background-color: @bg;
    border: 1px solid @border;
    color: @text;
    gridline-color: @border;
    selection-background-color: @select;
    selection-color: @text;
}
QTreeView::item, QTreeWidget::item { padding: 3px; }
QTreeView::item:selected, QTreeWidget::item:selected,
QTableView::item:selected, QListView::item:selected { background-color: @select; }
QTreeView::item:hover, QListView::item:hover { background-color: @hover; }

QHeaderView::section {
    background-color: @panel_alt;
    color: @text;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid @border;
    border-bottom: 1px solid @border;
}

/* ---- Tabs ---- */
QTabWidget::pane { border: 1px solid @border; }
QTabBar::tab { background-color: @panel_alt; color: @text_dim; padding: 8px 16px; border: none; }
QTabBar::tab:selected { background-color: @bg; color: @text; border-bottom: 2px solid @accent; }
QTabBar::tab:hover:!selected { background-color: @hover; color: @text; }

/* ---- Inputs ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: @panel;
    color: @text;
    border: 1px solid @border;
    border-radius: 2px;
    padding: 4px;
    selection-background-color: @select;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border: 1px solid @accent;
}
QLineEdit:disabled, QComboBox:disabled { color: @text_dim; }
QComboBox QAbstractItemView {
    background-color: @panel; color: @text; border: 1px solid @border; selection-background-color: @select;
}

QCheckBox { background: transparent; spacing: 6px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid @border; background: @panel; border-radius: 2px; }
QCheckBox::indicator:checked { background: @accent; border-color: @accent; }

QGroupBox { border: 1px solid @border; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: @accent; }

/* ---- Buttons ---- */
QPushButton {
    background-color: @panel_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 2px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: @hover; border-color: @accent; }
QPushButton:pressed { background-color: @select; }
QPushButton:disabled { color: @text_dim; border-color: @panel_alt; }
QPushButton[role="primary"] { background-color: @select; border-color: @accent; }
QPushButton[role="danger"] { border-color: @danger; color: @danger; }

/* ---- Scrollbars (thin, SCADA style) ---- */
QScrollBar:vertical { background: @bg; width: 12px; margin: 0; }
QScrollBar:horizontal { background: @bg; height: 12px; margin: 0; }
QScrollBar::handle:vertical { background: @border; min-height: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:horizontal { background: @border; min-width: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:hover { background: @accent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---- Status bar ---- */
QStatusBar { background-color: @panel_alt; color: @text_dim; border-top: 1px solid @border; }
QStatusBar::item { border: none; }
